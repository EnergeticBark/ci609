@hostname = bsh23.brighton.domains

### Send POST request
POST https://{{hostname}}/ci609/api/sightings
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="pangolin.jpg"

< ./images/pangolin.jpg

--WebAppBoundary
Content-Disposition: form-data; name="deathType"

fence

--WebAppBoundary
Content-Disposition: form-data; name="time"

1764435302226

--WebAppBoundary
Content-Disposition: form-data; name="latitude"

0.0

--WebAppBoundary
Content-Disposition: form-data; name="longitude"

0.0

--WebAppBoundary
Content-Disposition: form-data; name="accuracy"

1.0
--WebAppBoundary--
Content-Disposition: form-data; name="notes"

This is my note.
--WebAppBoundary--

> {%
    client.test("Request executed successfully", () => {
        client.assert(response.status === 201, "Response status is not 201");
    });
%}

### Send POST request without image
POST https://{{hostname}}/ci609/api/sightings
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="deathType"

fence

--WebAppBoundary
